<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SmsForwarder" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#0D47A1</item>
        <item name="colorPrimaryContainer">#E3F2FD</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">#00897B</item>
        <item name="colorSecondaryContainer">#E0F2F1</item>
        <item name="android:statusBarColor">#0D47A1</item>
        <item name="android:navigationBarColor">#FAFAFA</item>
        <item name="android:windowLightNavigationBar">true</item>
        <!-- Dialog readability -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.SmsForwarder.Dialog</item>
    </style>

    <style name="ThemeOverlay.SmsForwarder.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:background">#FFFFFF</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#212121</item>
        <item name="android:textColorPrimary">#212121</item>
        <item name="android:textColorSecondary">#424242</item>
    </style>
</resources>
